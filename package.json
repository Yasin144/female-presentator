{
    "name": "presentator",
    "version": "1.0.0",
    "description": "Presentator Educational Video Studio",
    "main": "main.cjs",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --windows",
        "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
        "dev:mobile": "vite --host 0.0.0.0 --port 5173",
        "mobile": "node scripts/start-mobile.cjs",
        "build:react": "vite build",
        "build:mobile-apps": "vite build --config vite.mobile.config.js",
        "ota:stage": "node scripts/stage-mobile-ota.mjs",
        "ota:validate": "node scripts/stage-mobile-ota.mjs --validate-only",
        "ota:stage:salary": "node scripts/stage-mobile-ota.mjs --app salary",
        "ota:validate:salary": "node scripts/stage-mobile-ota.mjs --app salary --validate-only",
        "test:mobile-apps": "node scripts/test-salary-ui.cjs && node scripts/test-navigation-history.cjs && node scripts/test-ota-update-policy.cjs && node scripts/test-ot-reminders.cjs && node scripts/test-transaction-presentation.cjs && node scripts/test-transaction-memory.cjs && node scripts/test-whatsapp-attendance.cjs && node scripts/test-expense-export.cjs",
        "android:mobile-apps": "npm run build:mobile-apps && npx cap sync android && cd android && gradlew.bat testSalaryDebugUnitTest testUdhaarDebugUnitTest assembleSalaryDebug assembleUdhaarDebug",
        "android:add": "npx cap add android",
        "android:sync": "npm run build:mobile-apps && npx cap sync android",
        "android:open": "npx cap open android",
        "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
        "preview": "vite preview",
        "test:caption-local": "node scripts/test-caption-local-all.cjs",
        "test:captions": "node scripts/test-caption-local-all.cjs --browser"
    },
    "author": "Anjali",
    "license": "ISC",
    "build": {
        "appId": "com.presentator.app",
        "files": [
            "**/*",
            "!**/.groq_api_key",
            "!**/.gemini_api_key",
            "!**/.hf_token",
            "!**/.env",
            "!**/.env.*",
            "!**/.caption-eraser-venv/**",
            "!**/temp/**",
            "!**/dist/**",
            "!**/logs/**",
            "!**/cache/**",
            "!**/generated-media/**",
            "!**/tts-cache/**",
            "!**/*.wav",
            "!**/*.mp3",
            "!**/*.tmp"
        ],
        "extraResources": [
            {
                "from": "Setup-Caption-Eraser-AI.ps1",
                "to": "Setup-Caption-Eraser-AI.ps1"
            }
        ],
        "win": {
            "target": "portable",
            "forceCodeSigning": false
        }
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.0",
        "@eslint/js": "^10.0.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "autoprefixer": "10.5.4",
        "electron": "41.10.5",
        "electron-builder": "26.15.3",
        "eslint": "10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "0.5.4",
        "globals": "17.11.0",
        "postcss": "8.5.26",
        "tailwindcss": "^3.4.19",
        "vite": "8.2.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "exceljs": "4.4.0",
        "flow-sdk": "^0.3.1",
        "framer-motion": "12.43.0",
        "html2canvas": "^1.4.1",
        "jsonrepair": "3.15.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "5.0.8",
        "jszip": "^3.10.1",
        "lucide-react": "^0.468.0",
        "magic-hour": "^0.70.0",
        "pdfjs-dist": "6.2.108",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "whatsapp-web.js": "1.34.7",
        "zustand": "5.0.15"
    },
    "type": "module"
}
